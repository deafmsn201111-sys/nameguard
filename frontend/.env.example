# Copy to `.env.local` (frontend) and adjust.
# NOT committed to git (see .gitignore).

# Network: testnet (default) or mainnet
VITE_NEAR_NETWORK=testnet

# RPC endpoint
# testnet: https://rpc.testnet.near.org
# mainnet: https://rpc.mainnet.near.org
VITE_NEAR_NODE_URL=https://rpc.testnet.near.org

# Wallet URL (MyNearWallet)
# testnet: https://testnet.mynearwallet.com
# mainnet: https://app.mynearwallet.com
VITE_NEAR_WALLET_URL=https://testnet.mynearwallet.com

# Helper URL (optional)
VITE_NEAR_HELPER_URL=https://helper.testnet.near.org

# Contract account id
# testnet: nameguard.testnet
# mainnet: nameguard.near
VITE_NEAR_CONTRACT_ID=nameguard.testnet

# Explorer
VITE_NEAR_EXPLORER_URL=https://testnet.nearblocks.io